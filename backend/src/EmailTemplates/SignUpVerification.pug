// verification-email.pug
doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Verify Your Email
  body(style="margin:0; padding:0; background-color:#121212; font-family:Arial, Helvetica, sans-serif; color:#ededed;")
    table(width="100%" cellpadding="0" cellspacing="0" style="background-color:#121212; padding:40px 16px;")
      tr
        td(align="center")
          // Main Card
          table(
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="max-width:400px;margin:0 auto;background-color:#1e1e1e;border-radius:12px;padding:26px;box-shadow:0 8px 30px rgba(0,0,0,0.6);"
          )
            // Logo / Brand
            tr
              td(align="center" style="padding-bottom:12px;")
                div(
                  style="width:36px;height:36px;border-radius:8px;background:#2a2a2a;display:flex;align-items:center;justify-content:center;color:#BB86FC;font-size:18px;font-weight:bold;"
                )
                  | ⚡
                p(style="margin:6px 0 0;font-size:11px;color:#A1A1AA;letter-spacing:1px;")
                  | YOUR COMPANY

            // Heading
            tr
              td(align="center" style="padding:12px 0 8px;")
                h2(style="margin:0; color:#ededed; font-size:20px;")
                  | Verify your email address

            // Description
            tr
              td(style="padding:0 0 16px; color:#A1A1AA; font-size:13px; line-height:1.6; text-align:center;")
                | Hi #{username},
                br
                | Please use the 6-digit verification code below to confirm your account and unlock full access.

            // Code Box
            tr
              td(align="center" style="padding:14px 0 6px;")
                div(
                  style="display:inline-block;background:#121212;border:1px solid #BB86FC;border-radius:10px;padding:14px 26px;"
                )
                  span(
                    style="font-size:22px;font-weight:bold;letter-spacing:6px;color:#BB86FC;user-select:all;"
                  )
                    | #{code}

            tr
              td(style="color:#A1A1AA; font-size:12px; text-align:center; padding-bottom:10px;")
                | Tip: Select the code above and copy it to your clipboard.

            // Copy Code Button (visual only – no JS in email)
            tr
              td(align="center" style="padding:14px 0 4px;")
                a(
                  href="#"
                  style="display:inline-block;background:#BB86FC;color:#121212;text-decoration:none;font-weight:600;font-size:13px;padding:12px 30px;border-radius:8px;letter-spacing:0.6px;"
                )
                  | COPY CODE

            // Expiry text
            tr
              td(style="padding-top:10px; color:#A1A1AA; font-size:12px; text-align:center;")
                | ⏱ This code expires in 10 minutes.

            // Divider
            tr
              td(style="padding:18px 0;")
                div(style="height:1px; background:#2a2a2a; width:100%;")

            // Footer
            tr
              td(style="text-align:center;")
                p(style="margin:0; color:#A1A1AA; font-size:11px;")
                  | © #{year} Your Company Name. All rights reserved.
                p(style="margin:6px 0 0; color:#A1A1AA; font-size:11px;")
                  | Need help? Contact us at 
                  a(
                    href="mailto:support@yourdomain.com"
                    style="color:#BB86FC; text-decoration:none;"
                  )
                    | support@yourdomain.com
