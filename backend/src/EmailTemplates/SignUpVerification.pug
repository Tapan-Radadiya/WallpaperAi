// verification-email.pug
doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Verify Your Account
  body(style="margin:0; padding:0; background-color:#121212; font-family:Arial, Helvetica, sans-serif; color:#ededed;")
    table(width="100%" cellpadding="0" cellspacing="0" style="background-color:#121212; padding:30px 0;")
      tr
        td(align="center")
          table(width="100%" cellpadding="0" cellspacing="0" style="max-width:480px; background-color:#1e1e1e; border-radius:8px; padding:24px;")
            tr
              td(align="center" style="padding-bottom:20px;")
                h1(style="margin:0; color:#BB86FC; font-size:24px;")
                  | Verify Your Email

            tr
              td(style="padding-bottom:12px; color:#ededed; font-size:14px; line-height:1.6;")
                | Hi #{username},
                br
                | Thank you for signing up! Please use the verification code below to confirm your email address.

            tr
              td(align="center" style="padding:20px 0;")
                div(style="display:inline-block; background-color:#121212; border:1px dashed #BB86FC; border-radius:6px; padding:12px 24px;")
                  span(style="font-size:24px; font-weight:bold; letter-spacing:4px; color:#BB86FC;")
                    | #{code}

            tr
              td(style="padding-bottom:12px; color:#A1A1AA; font-size:13px; line-height:1.6; text-align:center;")
                | This code is valid for the next 10 minutes.
                br
                | If you didn’t request this, you can safely ignore this email.

            tr
              td(style="padding-top:16px; border-top:1px solid #2a2a2a; text-align:center;")
                p(style="margin:0; color:#A1A1AA; font-size:12px;")
                  | © #{year} Your Company Name. All rights reserved.
                p(style="margin:4px 0 0; color:#A1A1AA; font-size:12px;")
                  | Need help? Contact us at 
                  a(href="mailto:support@yourdomain.com" style="color:#BB86FC; text-decoration:none;")
                    | support@yourdomain.com
