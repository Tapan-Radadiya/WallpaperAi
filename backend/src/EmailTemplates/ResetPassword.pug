doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Reset Your Password
  body(style="margin:0;padding:0;background-color:#121212;font-family:Arial,Helvetica,sans-serif;color:#ededed;")
    table(width="100%" cellpadding="0" cellspacing="0" style="background-color:#121212;padding:40px 16px;")
      tr
        td(align="center")
          table(
            width="100%",
            cellpadding="0",
            cellspacing="0",
            style="max-width:400px;margin:0 auto;background-color:#1e1e1e;border-radius:12px;padding:26px;"
          )

            // Logo
            tr
              td(align="center" style="padding-bottom:14px;")
                div(style="width:36px;height:36px;border-radius:8px;background:#2a2a2a;display:flex;align-items:center;justify-content:center;color:#BB86FC;font-size:18px;font-weight:bold;") 🔒
                p(style="margin:6px 0 0;font-size:11px;color:#A1A1AA;letter-spacing:1px;")
                  | YOUR COMPANY

            // Title
            tr
              td(align="center" style="padding:12px 0 6px;")
                h2(style="margin:0;font-size:20px;color:#ededed;")
                  | Reset your password

            // Description
            tr
              td(style="padding:0 0 18px;font-size:13px;line-height:1.6;color:#A1A1AA;text-align:center;")
                | Hi #{username},
                br
                | We received a request to reset your account password. Click the button below to continue.

            // Reset Button
            tr
              td(align="center" style="padding:16px 0;")
                a(
                  href=resetLink,
                  style="display:inline-block;background:#BB86FC;color:#121212;text-decoration:none;font-weight:600;font-size:14px;padding:12px 32px;border-radius:8px;letter-spacing:0.5px;"
                ) RESET PASSWORD

            // Fallback Link
            tr
              td(style="padding-top:8px;font-size:12px;color:#A1A1AA;text-align:center;line-height:1.5;")
                | If the button doesn’t work, copy and paste this link into your browser:
                br
                a(
                  href=resetLink,
                  style="color:#BB86FC;word-break:break-all;text-decoration:none;"
                ) #{resetLink}

            // Expiry Notice
            tr
              td(style="padding-top:12px;font-size:12px;color:#A1A1AA;text-align:center;")
                | ⏱ This link will expire in 15 minutes.

            // Divider
            tr
              td(style="padding:18px 0;")
                div(style="height:1px;background:#2a2a2a;width:100%;")

            // Footer
            tr
              td(style="text-align:center;")
                p(style="margin:0;font-size:11px;color:#A1A1AA;")
                  | If you didn’t request a password reset, you can safely ignore this email.
                p(style="margin:6px 0 0;font-size:11px;color:#A1A1AA;")
                  | © #{year} Your Company Name
