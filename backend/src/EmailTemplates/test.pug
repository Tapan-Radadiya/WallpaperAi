//- file: index.pug
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title || 'Pug Test Template'}

    style.
      body {
        font-family: Arial, sans-serif;
        margin: 2rem;
        background: #f5f5f5;
      }
      header, footer {
        background: #222;
        color: #fff;
        padding: 1rem;
      }
      main {
        background: #fff;
        padding: 1.5rem;
        margin-top: 1rem;
      }

  body
    header
      h1 Pug Test Template
      p This page was rendered using Pug 🐶

    main
      h2 Hello, #{user || 'Guest'}!

      if isLoggedIn
        p.status You are logged in.
      else
        p.status You are not logged in.

      h3 Features
      ul
        each feature in features
          li= feature

      form(method="post" action="/submit")
        label(for="email") Email:
        input#email(type="email" name="email" required)
        br
        button(type="submit") Submit

    footer
      p © #{new Date().getFullYear()} My Test App
